{
  "name": "pageforge",
  "version": "0.4.0",
  "description": "可视化网页设计器 - 拖拽生成 HTML",
  "main": "electron-main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --config vite.singlefile.config.mjs && vite build --config vite.singlefile-v2.config.mjs",
    "preview": "vite preview",
    "dist": "electron-builder --win portable",
    "regression": "node scripts/regression.mjs"
  },
  "dependencies": {
    "grapesjs": "^0.23.4",
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "build": {
    "appId": "com.hermes.pageforge",
    "productName": "PageForge",
    "icon": "build/icon.ico",
    "directories": {
      "output": "C:/Users/simple_pear/AppData/Local/Temp/pf-release"
    },
    "files": [
      "electron-main.js",
      "dist-single/index.html",
      "dist-single/editor-v2.html"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "PageForge.exe"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  }
}
